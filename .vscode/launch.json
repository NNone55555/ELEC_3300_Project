{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flash active CMake target (ST-Link)",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${config:cmake.sourceDirectory}",
            "deviceName": "STM32F103VET6",
            "deviceCore": "Cortex-M3",
            "preBuild": "",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:cmake.launchTargetPath}"
                }
            ]
        }
    ]
}
